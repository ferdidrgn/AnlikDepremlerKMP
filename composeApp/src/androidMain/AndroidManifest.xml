<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- 🎯 BÜTÜN CİHAZLARI AÇAN KRİTİK DONANIM ESNETMELERİ -->
    <!-- Google Play'in "GPS yoksa / Arama yoksa elerim" şartını TAMAMEN kaldırıyoruz -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- 🎯 COMPOSE & MAPS İÇİN GRAFİK ŞARTINI ESNETME -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <queries>
        <!-- 1. Google Play Store uygulamasının varlığını sorgulamaya izin verir (In-App Review / Coffee Donation / Güncelleme kontrolleri için şarttır). -->
        <package android:name="com.android.vending" />

        <!-- 2. Google Play Hizmetleri'nin (Google Maps, Location, Firebase) cihazda yüklü olup olmadığını denetler. -->
        <package android:name="com.google.android.gms" />

        <!-- 3. Uygulama içinden bir linke tıklandığında (örn: Gizlilik Politikası, Harita Linki) cihazdaki varsayılan Web Tarayıcısını (Chrome vb.) açabilmesini sağlar. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!-- 4. Kullanıcı acil durumda veya ayarlarda bir telefon numarasına tıkladığında Arama/Arama Ekranını (Dialer) açabilmesine izin verir. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>

        <!-- 5. Android 11+ paket görünürlüğü kısıtlaması: TextToSpeech, cihazdaki sesli okuma motorlarını bu olmadan göremez (sesli uyarı özelliği için şart). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".EarthquakeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!-- 🔔 1. FIREBASE MESSAGING SERVICE (<application> İÇİNE TAŞINDI) -->
        <service
            android:name=".core.notification.EarthquakeFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 👈 2. ÇAKIŞMAYI ÇÖZEN ÖZEL PROPERTY EKLEMESİ -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- 🖼️ 3. PAYLAŞIM KARTI GÖRSELİ İÇİN FILEPROVIDER (cache/shared_images altına yazılan PNG) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${API_KEY_ADMOB}" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${API_KEY_LOCATION}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 🌐 1. WEB DEEPLINK (https://anlikdeprem.web.app/earthquake/... , /map) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="anlikdeprem.web.app"
                    android:pathPrefix="/earthquake"
                    android:scheme="https" />
                <data
                    android:host="anlikdeprem.web.app"
                    android:pathPrefix="/map"
                    android:scheme="https" />
            </intent-filter>

            <!-- 📱 2. ÖZEL ŞEMA DEEPLINK (anlikdepremler://...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="anlikdepremler" />
            </intent-filter>
        </activity>

    </application>

</manifest>